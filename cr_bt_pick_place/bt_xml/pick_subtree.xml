<root BTCPP_format="4">
    <BehaviorTree ID="Pick">
        <SequenceWithMemory>

            <GuiLog main_msg = "Executing workflow" log_msg="Moving above target object..." phase="Pick Phase" percentage="10" target_id = "{object_id}" />
            <!-- Step 1: compute pre-approach position -->
            <Script
                code="pre_approach_z_coord := object_center_z + object_size_z / 2.0 + pre_approach_distance" />

            <!-- Step 2: move to pre-approach position -->
            <Action ID="ArmVerticalMove" name="MoveToPreApproachZ"
                target_z="{pre_approach_z_coord}" />

            <!-- Step 3: align horizontally over object -->
            <Action ID="ArmHorizontalMove" name="AlignOverObject"
                target_x="{object_center_x}"
                target_y="{object_center_y}" />

            <GuiLog main_msg = "Executing workflow" log_msg="Approaching target object..." phase="Pick Phase" percentage="30" target_id = "{object_id}" />
            <!-- Step 4: open gripper -->
            <Action ID="SetGripper" name="OpenGripper" target="{gripper_open}" />

            <!-- Step 5: compute approach position -->
            <Script
                code="approach_z_coord := object_center_z + object_size_z / 2.0 + approach_distance" />

            <!-- Step 6: approach object -->
            <Action ID="ArmVerticalMove" name="MoveToApproachZ"
                target_z="{approach_z_coord}" />

            <GuiLog main_msg = "Executing workflow" log_msg="Grasping target object..." phase="Pick Phase" percentage="50" target_id = "{object_id}" />
            <!-- Step 7: allow collisions -->
            <Action ID="SetCollisionAllowed" name="DisableCollisions"
                object_id="{object_id}"
                is_allowed="true" />

            <!-- Step 8: close gripper -->
            <Action ID="SetGripper" name="CloseGripper" target="{gripper_close}" />

            <!-- Step 9: attach object -->
            <Action ID="SetObjectAttached" name="AttachObject"
                object_id="{object_id}"
                attach="true" />

            <LogMessage message="Pick sequence completed!" />
        </SequenceWithMemory>
    </BehaviorTree>
</root>