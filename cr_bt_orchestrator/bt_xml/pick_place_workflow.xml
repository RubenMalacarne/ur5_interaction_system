<root BTCPP_format="4" main_tree_to_execute="PickAndPlaceWorkflow">
    <BehaviorTree ID="PickAndPlaceWorkflow">

        <!-- Fallback principale - se un umano richiede lo stop dell'esecuzione, allora l'albero
        deve terminare -->
        <Fallback>

            <ReactiveSequence name="ReactiveStopChecking">

                <Inverter>
                    <IsStopRequested />
                </Inverter>


                <RetryUntilSuccessful num_attempts="100" name="RetryUntilComplete">
                    <Sequence name="MonitoredPickAndPlaceAttempt">
                        <Action ID="WaitForTheGoAhead" />
                        <ReactiveSequence name="PickPlaceReactive">
                            <IsAreaSafe />
                            <Inverter>
                                <IsPauseRequested />
                            </Inverter>
                            <SequenceWithMemory name="PickAndPlaceSequence">
                                <!-- 1. Freeze scene -->
                                <Action ID="FreezeScene" freeze="true" />

                                <!-- 2. Get object information -->
                                <Action ID="GetObjectInfo"
                                    object_id="{object_id}"
                                    object_center_x="{object_center_x}"
                                    object_center_y="{object_center_y}"
                                    object_center_z="{object_center_z}"
                                    object_size_x="{object_size_x}"
                                    object_size_y="{object_size_y}"
                                    object_size_z="{object_size_z}"
                                />

                                <!-- 3. Pick object -->
                                <SubTree ID="Pick" _autoremap="true"
                                    object_id="{object_id}"
                                    object_center_x="{object_center_x}"
                                    object_center_y="{object_center_y}"
                                    object_center_z="{object_center_z}"
                                    object_size_z="{object_size_z}"
                                />

                                <!-- 4. Place object -->
                                <SubTree ID="Place" _autoremap="true"
                                    object_id="{object_id}"
                                    object_center_x="{object_center_x}"
                                    object_center_y="{object_center_y}"
                                    object_center_z="{object_center_z}"
                                    object_size_z="{object_size_z}"
                                />

                                <!-- 5. Unfreeze scene -->
                                <Action ID="FreezeScene" freeze="false" />

                                <!-- 6. Ritorno a casa -->
                                <Action ID="GoHome" />

                                <LogMessage message="Workflow successfully completed!" />
                            </SequenceWithMemory>
                        </ReactiveSequence>
                    </Sequence>
                </RetryUntilSuccessful>

            </ReactiveSequence>

            <!-- Se è stato richiesto uno stop durante l'esecuzione del workflow, l'albero deve
            terminare -->
            <Sequence>
                <!-- Cancellazione di ciò che era stato impostato per l'esecuzione corrente -->
                <Action ID="SetGripper" target="{gripper_open}" />
                <Action ID="SetObjectAttached" name="DetachObject"
                    object_id="{object_id}"
                    attach="false" />
                <Action ID="SetCollisionAllowed" name="EnableCollisions"
                    object_id="{object_id}"
                    is_allowed="false" />
                <Action ID="FreezeScene" freeze="false" />

                <!-- Ritorno in home, sempre controllando che la zona sia Safe -->
                <RetryUntilSuccessful num_attempts="100" name="RetryUntilComplete">
                    <Sequence name="MonitoredPickAndPlaceAttempt">
                        <!-- ora il parser vedrà subito il nodo registrato "WaitForTheGoAhead" -->
                        <WaitForTheGoAhead />
                        <ReactiveSequence name="GoHomeReactive">
                            <IsAreaSafe />
                            <Inverter>
                                <IsPauseRequested />
                            </Inverter>
                            <GoHome />
                        </ReactiveSequence>
                    </Sequence>
                </RetryUntilSuccessful>
                <LogMessage message="Execution successfully blocked!" />
            </Sequence>

        </Fallback>

    </BehaviorTree>
</root>