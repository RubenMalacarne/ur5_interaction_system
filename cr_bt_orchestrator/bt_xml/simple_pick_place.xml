<root BTCPP_format="4" main_tree_to_execute="GuardedPickAndPlace">
    <BehaviorTree ID="GuardedPickAndPlace">
        <RetryUntilSuccessful num_attempts="100" name="RetryUntilComplete">
            <Sequence name="MonitoredPickAndPlaceAttempt">
                    <Action ID="EnsureAreaIsSafe"/>
                    <ReactiveSequence name="PickPlaceReactive">
                        <IsAreaSafe/> 
                        <SequenceWithMemory name="PickAndPlaceSequence">    
                            <!-- 1. Congelamento la scena -->
                            <Action ID="FreezeScene" />

                            <!-- 2. Ottienere informazioni sull'oggetto (posizione, dimensione, ecc.) -->
                            <Action ID="GetObjectInfo"
                                object_id="{object_id}"
                                object_center_x="{object_center_x}"
                                object_center_y="{object_center_y}"
                                object_center_z="{object_center_z}"
                                object_size_x="{object_size_x}"
                                object_size_y="{object_size_y}"
                                object_size_z="{object_size_z}"
                            />

                            <!-- 3. Pick dell'oggetto -->
                            <SubTree ID="Pick"
                                ros_node="{ros_node}"
                                motion_commander="{motion_commander}"
                                gripper_open="{gripper_open}"
                                gripper_close="{gripper_close}"
                                object_id = "{object_id}"
                                object_center_x="{object_center_x}"
                                object_center_y="{object_center_y}"
                                object_center_z="{object_center_z}"
                                object_size_x="{object_size_x}"
                                object_size_y="{object_size_y}"
                                object_size_z="{object_size_z}" 
                                pre_approach_distance="{pre_approach_distance}"
                                approach_distance="{approach_distance}"/>

                            <!-- 4. Place dell'oggetto -->
                            <SubTree ID="Place"
                                ros_node="{ros_node}"
                                motion_commander="{motion_commander}"
                                gripper_open="{gripper_open}"
                                object_id = "{object_id}" 
                                place_offset_x="{place_offset_x}"
                                place_offset_z="{place_offset_z}"
                                object_center_x="{object_center_x}"
                                object_center_y="{object_center_y}"
                                object_center_z="{object_center_z}"
                                object_size_z="{object_size_z}" 
                                pre_approach_distance="{pre_approach_distance}"
                                approach_distance="{approach_distance}"/>

                            <LogMessage message="Simple Workflow completato!" />
                        </SequenceWithMemory>
                    </ReactiveSequence>
                </Sequence>
        </RetryUntilSuccessful>
    </BehaviorTree>
</root>
